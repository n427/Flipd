# Flipd web (Next.js) — copy to .env.local and fill in.
# .env.local is gitignored. Never commit real values.

# --- Supabase (required) ---
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (required for AI description + safety review) ---
# src/lib/safety.ts and src/app/api/generate-description/route.ts use `new Anthropic()`,
# which reads this name implicitly.
ANTHROPIC_API_KEY=

# --- Google Maps (listing map / places autocomplete) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Email (OTP sign-in codes via Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Cron auth for /api/cron/popup-reminders ---
CRON_SECRET=

SMS_API_KEY=
SMS_API_URL=
SMS_FROM=
