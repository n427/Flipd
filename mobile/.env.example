# Flipd mobile (Expo) — copy to mobile/.env and fill in.
# mobile/.env is gitignored. Only PUBLIC values belong here: anything
# EXPO_PUBLIC_* is compiled into the app bundle and readable on-device.
# Never put SUPABASE_SERVICE_ROLE_KEY here.

# Same values as the web app's NEXT_PUBLIC_SUPABASE_* pair.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Maps + places autocomplete on the post/listing screens.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_PLACES_KEY=
